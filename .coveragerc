[run]
# Source code to measure
source = tiannara_core/evaluation

# Files/directories to exclude
omit = 
    */tests/*
    */test_*.py
    */debug_*.py
    */archive/*
    */__pycache__/*

[report]
# Minimum coverage threshold (fail if below this)
# TODO: Increase to 75% after adding more comprehensive tests
fail_under = 20

# Show missing lines in terminal output
show_missing = True

# Precision for coverage percentages
precision = 2

# Lines to exclude from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    \.\.\.

[html]
# HTML report directory
directory = htmlcov

# Open HTML report automatically
open = False
