{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/unified_framework.json",
  "title": "UnifiedFramework",
  "description": "A cross-domain explanatory framework integrating theories from multiple domains.",
  "type": "object",
  "properties": {
    "framework_id": { "type": "string", "pattern": "^framework_[a-f0-9]{16}$" },
    "name": { "type": "string" },
    "composing_theory_ids": { "type": "array", "items": { "type": "string" } },
    "cross_domain_principles": { "type": "array", "items": { "type": "string" } },
    "shared_mathematics": { "type": "string" },
    "unified_causal_structure": { "type": "string" },
    "integration_justification": { "type": "string" },
    "domain_specific_assumptions": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "evidence_coverage": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "parent_framework_ids": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["framework_id", "name", "composing_theory_ids", "integration_justification", "fingerprint"]
}
