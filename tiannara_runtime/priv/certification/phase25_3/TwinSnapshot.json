{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/twin_snapshot.json",
  "title": "TwinSnapshot",
  "description": "A deterministic snapshot of the planetary digital twin.",
  "type": "object",
  "properties": {
    "snapshot_id": { "type": "string", "pattern": "^tsnap_[a-f0-9]{16}$" },
    "twin_id": { "type": "string" },
    "version": { "type": "integer" },
    "layer_snapshots": { "type": "object" },
    "scenario_ids": { "type": "array", "items": { "type": "string" } },
    "fidelity_metrics": { "type": "object" },
    "parent_snapshot_id": { "type": "string" },
    "timestamp": { "type": "integer" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["snapshot_id", "twin_id", "version", "layer_snapshots", "fingerprint"]
}
