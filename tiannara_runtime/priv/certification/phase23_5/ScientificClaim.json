{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/scientific_claim.json",
  "title": "ScientificClaim",
  "description": "A scientific claim extracted from a publication, represented as a first-class constitutional object.",
  "type": "object",
  "properties": {
    "claim_id": { "type": "string", "pattern": "^clm_[a-f0-9]{16}$" },
    "claim_type": {
      "type": "string",
      "enum": ["observation", "relationship", "mechanism", "prediction", "methodology", "classification", "quantification", "comparison"]
    },
    "claim_text": { "type": "string" },
    "section_context": { "type": "string" },
    "publication_id": { "type": "string" },
    "supporting_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "contradiction_ids": { "type": "array", "items": { "type": "string" } },
    "credibility_level": {
      "type": "string",
      "enum": ["established", "supported", "suggestive", "inconclusive", "contradicted", "retracted"]
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extracted_at": { "type": "integer" }
  },
  "required": ["claim_id", "claim_type", "claim_text", "publication_id", "fingerprint"]
}
