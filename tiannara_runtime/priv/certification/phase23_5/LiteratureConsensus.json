{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/literature_consensus.json",
  "title": "LiteratureConsensus",
  "description": "The state of scientific consensus on a topic, derived from evidence across multiple publications.",
  "type": "object",
  "properties": {
    "consensus_id": { "type": "string", "pattern": "^cons_[a-f0-9]{16}$" },
    "topic": { "type": "string" },
    "consensus_state": {
      "type": "string",
      "enum": ["strong_consensus", "emerging_consensus", "fragmented_consensus", "no_consensus", "contested"]
    },
    "supporting_publication_ids": { "type": "array", "items": { "type": "string" } },
    "contradicting_publication_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_weight_for": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_weight_against": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "previous_state": { "type": "string" },
          "new_state": { "type": "string" },
          "reason": { "type": "string" },
          "changed_at": { "type": "integer" }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "updated_at": { "type": "integer" }
  },
  "required": ["consensus_id", "topic", "consensus_state", "fingerprint"]
}
