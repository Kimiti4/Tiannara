{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/scientific_objection.json",
  "title": "ScientificObjection",
  "description": "A formal scientific objection raised during peer review.",
  "type": "object",
  "properties": {
    "objection_id": { "type": "string", "pattern": "^obj_[a-f0-9]{16}$" },
    "review_id": { "type": "string" },
    "artifact_id": { "type": "string" },
    "claim_reference": { "type": "string" },
    "objection_type": { "type": "string", "enum": ["evidence", "methodology", "logic", "alternative", "reproducibility", "constitutional"] },
    "supporting_evidence": { "type": "string" },
    "reasoning": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor", "informational"] },
    "recommended_resolution": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "under_review", "resolved", "overruled", "withdrawn"] },
    "resolution_response": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["objection_id", "artifact_id", "objection_type", "supporting_evidence", "severity", "status", "fingerprint"]
}
