{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/scientific_critique.json",
  "title": "ScientificCritique",
  "description": "A constitutional critique of a scientific artifact with evidence-backed assessments across multiple dimensions.",
  "type": "object",
  "properties": {
    "critique_id": { "type": "string", "pattern": "^crit_[a-f0-9]{16}$" },
    "review_id": { "type": "string" },
    "dimension_assessments": {
      "type": "object",
      "properties": {
        "logical_consistency": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence": { "type": "string" } } },
        "causal_consistency": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence": { "type": "string" } } },
        "empirical_consistency": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence": { "type": "string" } } },
        "engineering_consistency": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence": { "type": "string" } } },
        "cross_domain_consistency": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence": { "type": "string" } } },
        "constitutional_consistency": { "type": "object", "properties": { "passed": { "type": "boolean" }, "details": { "type": "string" } } }
      }
    },
    "overall_assessment": { "type": "string" },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["critique_id", "review_id", "overall_assessment", "fingerprint"]
}
