{
  "schema": "EVOLUTION_REPLAY_SCHEMA",
  "version": "22.6",
  "description": "Schema for replay verification of an evolution event",
  "evolution_replay": {
    "fields": {
      "replay_id": {"type": "string", "required": true},
      "evolution_event_type": {"type": "string", "required": true, "enum": ["epoch_transition", "adaptive_change", "institution_evolution", "knowledge_evolution", "technology_evolution", "continuity_verified"]},
      "event_fingerprint": {"type": "string", "required": true},
      "reconstructed_hash": {"type": "string", "required": true},
      "stored_hash": {"type": "string", "required": true},
      "verification_status": {"type": "string", "required": true, "enum": ["verified", "diverged", "incomplete"]},
      "generation": {"type": "integer", "required": true},
      "fingerprint": {"type": "string", "required": true}
    },
    "constraints": ["deterministic", "immutable", "chain_verified"]
  }
}
