{
  "schema": "OPTIMIZATION_SCORE_SCHEMA",
  "version": "22.4",
  "description": "Schema for a civilization design score across a single objective",
  "optimization_score": {
    "fields": {
      "score_id": {"type": "string", "required": true},
      "candidate_id": {"type": "string", "required": true},
      "objective": {"type": "string", "required": true},
      "score_value": {"type": "number", "required": true, "description": "0.0–1.0"},
      "confidence_interval": {"type": "array", "required": true},
      "score_components": {"type": "object", "required": true},
      "evaluation_method": {"type": "string", "required": true, "enum": ["direct_calculation", "simulation_projection", "historical_analogy", "expert_elicitation"]},
      "fingerprint": {"type": "string", "required": true}
    },
    "constraints": ["deterministic", "interpretable", "traceable"]
  }
}
