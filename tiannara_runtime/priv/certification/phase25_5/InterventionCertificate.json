{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/intervention_certificate.json",
  "title": "InterventionCertificate",
  "description": "Certification for CPISE or its components.",
  "type": "object",
  "properties": {
    "certificate_id": { "type": "string", "pattern": "^icert_[a-f0-9]{16}$" },
    "entity_id": { "type": "string" },
    "entity_type": { "type": "string", "enum": ["cpise", "strategy_engine", "modeling_engine", "optimization_engine", "deployment_engine", "monitoring_engine", "adaptation_engine"] },
    "certification_type": { "type": "string", "enum": ["architecture", "strategy", "modeling", "optimization", "deployment", "monitoring", "adaptation", "replay", "data"] },
    "checks": {
      "type": "object",
      "properties": {
        "constitutional_compliant": { "type": "boolean" },
        "deterministic": { "type": "boolean" },
        "replayable": { "type": "boolean" },
        "uncertainty_explicit": { "type": "boolean" },
        "human_reviewable": { "type": "boolean" }
      },
      "required": ["constitutional_compliant", "deterministic", "replayable"]
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certified_at": { "type": "integer" }
  },
  "required": ["certificate_id", "entity_id", "entity_type", "certification_type", "checks", "fingerprint"]
}
