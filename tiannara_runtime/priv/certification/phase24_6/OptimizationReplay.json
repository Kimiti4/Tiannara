{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/optimization_replay.json",
  "title": "OptimizationReplay",
  "description": "A replay event recording a deterministic optimization operation.",
  "type": "object",
  "properties": {
    "replay_id": { "type": "string", "pattern": "^oreplay_[a-f0-9]{16}$" },
    "event_type": {
      "type": "string",
      "enum": ["bottleneck_detection", "candidate_generation", "tradeoff_analysis", "optimization_verification", "optimization_validation", "baseline_update", "evolution_cycle"]
    },
    "input_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "output_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "analysis_parameters": { "type": "object" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer" }
  },
  "required": ["replay_id", "event_type", "input_snapshots", "output_snapshots", "content_hash"]
}
