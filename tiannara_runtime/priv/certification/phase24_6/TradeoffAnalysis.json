{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/tradeoff_analysis.json",
  "title": "TradeoffAnalysis",
  "description": "A constitutional tradeoff analysis between competing optimization objectives.",
  "type": "object",
  "properties": {
    "analysis_id": { "type": "string", "pattern": "^tradeoff_[a-f0-9]{16}$" },
    "candidate_id": { "type": "string" },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objective": { "type": "string", "enum": ["performance", "reliability", "safety", "cost", "mass", "energy", "manufacturability", "scalability", "maintainability", "sustainability", "resilience", "civilizational_benefit"] },
          "baseline_value": { "type": "number" },
          "candidate_value": { "type": "number" },
          "change_pct": { "type": "number" },
          "acceptable": { "type": "boolean" }
        },
        "required": ["objective", "baseline_value", "candidate_value"]
      }
    },
    "selected": { "type": "boolean" },
    "selection_rationale": { "type": "string" },
    "constitutional_review_notes": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "analyzed_at": { "type": "integer" }
  },
  "required": ["analysis_id", "candidate_id", "objectives", "fingerprint"]
}
