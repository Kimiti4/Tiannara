{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/optimization_metrics.json",
  "title": "OptimizationMetrics",
  "description": "Metrics tracking engineering optimization performance and impact.",
  "type": "object",
  "properties": {
    "metrics_id": { "type": "string", "pattern": "^omets_[a-f0-9]{16}$" },
    "system_id": { "type": "string" },
    "snapshot_timestamp": { "type": "integer" },
    "metrics": {
      "type": "object",
      "properties": {
        "optimization_yield": { "type": "number", "minimum": 0, "maximum": 1 },
        "performance_improvement": { "type": "number" },
        "cost_reduction": { "type": "number" },
        "reliability_growth": { "type": "number" },
        "manufacturing_improvement": { "type": "number" },
        "energy_efficiency": { "type": "number" },
        "lifecycle_cost": { "type": "number" },
        "resilience_growth": { "type": "number" },
        "civilizational_benefit": { "type": "number" },
        "optimization_replay_accuracy": { "type": "number" }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["metrics_id", "system_id", "snapshot_timestamp", "metrics", "fingerprint"]
}
