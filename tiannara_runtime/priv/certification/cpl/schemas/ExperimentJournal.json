{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentJournal",
  "description": "A journal tracking an experiment through its lifecycle with stage-level resumption",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "description": "Unique identifier for this experiment"
    },
    "experiment_name": {
      "type": "string",
      "description": "Human-readable experiment name"
    },
    "total_stages": {
      "type": "integer",
      "description": "Total number of stages in this experiment"
    },
    "current_stage": {
      "type": "integer",
      "description": "Current stage number (1-indexed)"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperimentStage"
      },
      "description": "Array of experiment stages"
    },
    "inputs": {
      "type": "object",
      "description": "Experiment inputs"
    },
    "output": {
      "type": "object",
      "description": "Experiment output (null if not completed)"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "interrupted"],
      "description": "Current experiment status"
    },
    "created_at": {
      "type": "integer",
      "description": "Constitutional timestamp of experiment creation"
    },
    "last_checkpoint_at": {
      "type": "integer",
      "description": "Constitutional timestamp of last checkpoint"
    },
    "hash": {
      "type": "string",
      "description": "SHA-256 hash of the experiment journal"
    },
    "checkpoint_root": {
      "type": "string",
      "description": "Reference to checkpoint root"
    },
    "replay_root": {
      "type": "string",
      "description": "Reference to replay root"
    },
    "archaeology_root": {
      "type": "string",
      "description": "Reference to archaeology root"
    },
    "certification_root": {
      "type": "string",
      "description": "Reference to certification root"
    }
  },
  "required": ["experiment_id", "experiment_name", "total_stages", "current_stage", "stages", "inputs", "status", "created_at", "hash"],
  "additionalProperties": false,
  "definitions": {
    "ExperimentStage": {
      "type": "object",
      "properties": {
        "stage_number": {
          "type": "integer",
          "description": "Stage number (1-indexed)"
        },
        "stage_name": {
          "type": "string",
          "description": "Human-readable stage name"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "failed"],
          "description": "Current stage status"
        },
        "started_at": {
          "type": "integer",
          "description": "Constitutional timestamp of stage start"
        },
        "completed_at": {
          "type": "integer",
          "description": "Constitutional timestamp of stage completion"
        },
        "inputs": {
          "type": "object",
          "description": "Stage inputs"
        },
        "outputs": {
          "type": "object",
          "description": "Stage outputs (null if not completed)"
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 hash of the stage"
        }
      },
      "required": ["stage_number", "stage_name", "status", "inputs"]
    }
  }
}
