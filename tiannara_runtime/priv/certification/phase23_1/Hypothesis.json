{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypothesis",
  "description": "A testable proposition proposed in response to a scientific question",
  "type": "object",
  "properties": {
    "hypothesis_id": { "type": "string" },
    "question_id": { "type": "string" },
    "proposition": { "type": "string" },
    "domain": { "type": "string" },
    "confidence": { "type": "number" },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "expected_falsifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "competing_hypotheses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "supported", "contradicted", "rejected", "retired"]
    },
    "evidence_for": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_against": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "integer" },
    "hypothesis_hash": { "type": "string" }
  },
  "required": ["hypothesis_id", "question_id", "proposition", "domain", "status", "created_at", "hypothesis_hash"],
  "additionalProperties": false
}
