{
  "schema": "MISSION_REPLAY_SCHEMA",
  "version": "21.3",
  "description": "Schema for mission replay — deterministic reconstruction of the mission generation system",
  "mission_replay": {
    "fields": {
      "replay_id": {"type": "string", "required": true, "description": "Content-addressed replay identifier"},
      "replay_type": {"type": "string", "required": true, "description": "FullSystem/MissionGeneration/Dependency/Feasibility/Validation"},
      "step_hashes": {
        "type": "array", "required": true,
        "items": {
          "type": "object",
          "fields": {
            "step": {"type": "integer"}, "entity": {"type": "string"},
            "operation": {"type": "string"}, "input_hash": {"type": "string"},
            "output_hash": {"type": "string"}, "step_hash": {"type": "string"}
          }
        }
      },
      "root_hash_original": {"type": "string", "required": true},
      "root_hash_reconstructed": {"type": "string", "required": true},
      "all_hashes_match": {"type": "boolean", "required": true},
      "missions_replayed": {"type": "integer", "required": true},
      "programs_replayed": {"type": "integer", "required": true},
      "status": {"type": "string", "required": true, "description": "Pending/Verified/Failed"},
      "fingerprint": {"type": "string", "required": true}
    },
    "replay_types": ["full_system", "mission_generation", "dependency", "feasibility", "validation"],
    "constraints": ["deterministic_replay", "identical_hashes_required"]
  }
}