{
  "schema": "STRATEGY_REPLAY_SCHEMA",
  "version": "21.7",
  "description": "Schema for strategy replay — deterministic reconstruction of the scientific strategy system",
  "strategy_replay": {
    "fields": {
      "replay_id": {"type": "string", "required": true, "description": "Content-addressed replay identifier"},
      "replay_type": {"type": "string", "required": true, "description": "FullStrategy/Roadmap/Trajectory/Priority/Alignment"},
      "replay_generation": {"type": "integer", "required": true},
      "step_hashes": {
        "type": "array", "required": true,
        "items": {
          "type": "object",
          "fields": {
            "step": {"type": "integer"}, "operation": {"type": "string"},
            "input_hash": {"type": "string"}, "output_hash": {"type": "string"},
            "step_hash": {"type": "string"}
          }
        }
      },
      "root_hash_original": {"type": "string", "required": true},
      "root_hash_reconstructed": {"type": "string", "required": true},
      "all_hashes_match": {"type": "boolean", "required": true},
      "roadmaps_replayed": {"type": "integer", "required": true},
      "objectives_replayed": {"type": "integer", "required": true},
      "status": {"type": "string", "required": true, "description": "Pending/Verified/Failed"},
      "fingerprint": {"type": "string", "required": true}
    },
    "replay_types": ["full_strategy", "roadmap", "trajectory", "priority", "alignment"],
    "constraints": ["deterministic_replay", "identical_hashes_required", "cold_storage_independent"]
  }
}