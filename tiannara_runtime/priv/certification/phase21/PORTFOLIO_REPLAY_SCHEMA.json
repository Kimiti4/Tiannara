{
  "schema": "PORTFOLIO_REPLAY_SCHEMA",
  "version": "21.1",
  "description": "Schema for portfolio replay — deterministic reconstruction of all portfolio decisions",
  "portfolio_replay": {
    "fields": {
      "replay_id": {"type": "string", "required": true, "description": "Content-addressed replay identifier"},
      "replay_type": {"type": "string", "required": true, "description": "FullPortfolio/Program/Capital/Allocation/Succession"},
      "step_hashes": {
        "type": "array", "required": true,
        "items": {
          "type": "object",
          "fields": {
            "step": {"type": "integer"}, "entity": {"type": "string"},
            "decision_type": {"type": "string"}, "input_hash": {"type": "string"},
            "output_hash": {"type": "string"}, "step_hash": {"type": "string"}
          }
        }
      },
      "root_hash_original": {"type": "string", "required": true},
      "root_hash_reconstructed": {"type": "string", "required": true},
      "all_hashes_match": {"type": "boolean", "required": true},
      "programs_replayed": {"type": "integer", "required": true},
      "allocations_replayed": {"type": "integer", "required": true},
      "successions_replayed": {"type": "integer", "required": true},
      "status": {"type": "string", "required": true, "description": "Pending/Verified/Failed"},
      "fingerprint": {"type": "string", "required": true}
    },
    "replay_types": ["full_portfolio", "program", "capital", "allocation", "succession"],
    "constraints": ["deterministic_replay", "identical_hashes_required", "cold_storage_independent"]
  }
}