{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/observation_certificate.json",
  "title": "ObservationCertificate",
  "description": "Certification for the CGON or its components.",
  "type": "object",
  "properties": {
    "certificate_id": { "type": "string", "pattern": "^ocert_[a-f0-9]{16}$" },
    "entity_id": { "type": "string" },
    "entity_type": { "type": "string", "enum": ["observation_network", "observation_source", "observation_engine", "validation_method", "fusion_method", "provenance_system"] },
    "certification_type": { "type": "string", "enum": ["architecture", "source", "engine", "validation", "provenance", "fusion", "uncertainty", "replay"] },
    "checks": {
      "type": "object",
      "properties": {
        "provenance_complete": { "type": "boolean" },
        "validation_sound": { "type": "boolean" },
        "deterministic": { "type": "boolean" },
        "uncertainty_preserved": { "type": "boolean" },
        "replayable": { "type": "boolean" },
        "unknown_preserved": { "type": "boolean" }
      },
      "required": ["provenance_complete", "validation_sound", "deterministic", "replayable"]
    },
    "certifying_authority": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certified_at": { "type": "integer" }
  },
  "required": ["certificate_id", "entity_id", "entity_type", "certification_type", "checks", "fingerprint"]
}
