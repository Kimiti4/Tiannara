{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/provenance_record.json",
  "title": "ProvenanceRecord",
  "description": "A complete provenance record for an observation.",
  "type": "object",
  "properties": {
    "record_id": { "type": "string", "pattern": "^prov_[a-f0-9]{16}$" },
    "observation_id": { "type": "string" },
    "source_identity": { "type": "string" },
    "source_type": { "type": "string" },
    "capture_time": { "type": "integer" },
    "capture_location": { "type": "object" },
    "instrument": { "type": "string" },
    "calibration": { "type": "string" },
    "schema_version": { "type": "string" },
    "collector": { "type": "string" },
    "processing_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "operation": { "type": "string" },
          "method": { "type": "string" },
          "version": { "type": "string" },
          "parameters": { "type": "object" },
          "input_hash": { "type": "string" },
          "output_hash": { "type": "string" },
          "timestamp": { "type": "integer" },
          "performed_by": { "type": "string" }
        },
        "required": ["step", "operation", "input_hash", "output_hash"]
      }
    },
    "validation_chain": { "type": "array", "items": { "type": "object" } },
    "chain_hash": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["record_id", "observation_id", "source_identity", "capture_time", "processing_chain", "chain_hash", "fingerprint"]
}
