{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alert",
  "description": "An alert generated by the alert engine",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique identifier for this alert"
    },
    "alert_type": {
      "type": "string",
      "description": "Type of alert"
    },
    "severity": {
      "type": "string",
      "enum": ["informational", "warning", "error", "critical", "fatal"],
      "description": "Alert severity"
    },
    "title": {
      "type": "string",
      "description": "Alert title"
    },
    "description": {
      "type": "string",
      "description": "Alert description"
    },
    "subsystem": {
      "type": "string",
      "description": "Subsystem that generated the alert"
    },
    "timestamp": {
      "type": "integer",
      "description": "Constitutional timestamp of alert"
    },
    "metadata": {
      "type": "object",
      "description": "Alert metadata"
    },
    "status": {
      "type": "string",
      "enum": ["active", "acknowledged", "resolved", "suppressed"],
      "description": "Alert status"
    },
    "acknowledged_at": {
      "type": "integer",
      "description": "Timestamp when alert was acknowledged"
    },
    "resolved_at": {
      "type": "integer",
      "description": "Timestamp when alert was resolved"
    }
  },
  "required": ["alert_id", "alert_type", "severity", "title", "description", "subsystem", "timestamp", "status"],
  "additionalProperties": false
}
