{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservatorySnapshot",
  "description": "A snapshot of observatory state at a point in time",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string",
      "description": "Content-addressed identifier for this snapshot"
    },
    "timestamp": {
      "type": "integer",
      "description": "Constitutional timestamp of snapshot"
    },
    "observatory_state": {
      "type": "object",
      "description": "Complete observatory state",
      "properties": {
        "metrics": {
          "type": "object",
          "description": "Current metric values"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "TelemetryEvent.json"
          },
          "description": "Recent events"
        },
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "Alert.json"
          },
          "description": "Active alerts"
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detected anomalies"
        }
      },
      "required": ["metrics", "events", "alerts", "anomalies"]
    },
    "hash": {
      "type": "string",
      "description": "Content-addressed hash of snapshot"
    },
    "previous_snapshot_id": {
      "type": "string",
      "description": "ID of previous snapshot"
    },
    "metadata": {
      "type": "object",
      "description": "Snapshot metadata"
    }
  },
  "required": ["snapshot_id", "timestamp", "observatory_state", "hash"],
  "additionalProperties": false
}
