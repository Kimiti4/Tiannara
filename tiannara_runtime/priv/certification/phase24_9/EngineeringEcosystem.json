{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/engineering_ecosystem.json",
  "title": "EngineeringEcosystem",
  "description": "State representation of the engineering ecosystem, tracking all participant engines and their integration status.",
  "type": "object",
  "properties": {
    "ecosystem_id": { "type": "string", "pattern": "^ecosys_[a-f0-9]{16}$" },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engine_id": { "type": "string" },
          "engine_name": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "degraded", "isolated", "offline"] },
          "last_heartbeat": { "type": "integer" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["engine_id", "engine_name", "status", "last_heartbeat"]
      }
    },
    "integration_map": {
      "type": "object",
      "properties": {
        "active_integrations": { "type": "array", "items": { "type": "string" } },
        "pending_integrations": { "type": "array", "items": { "type": "string" } },
        "failed_integrations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ecosystem_health": { "type": "number", "minimum": 0, "maximum": 1 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot_at": { "type": "integer" }
  },
  "required": ["ecosystem_id", "participants", "ecosystem_health", "fingerprint"]
}
