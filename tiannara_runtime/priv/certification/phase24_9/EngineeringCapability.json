{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/engineering_capability.json",
  "title": "EngineeringCapability",
  "description": "A declared engineering capability within the CCEIE ecosystem.",
  "type": "object",
  "properties": {
    "capability_id": { "type": "string", "pattern": "^ecap_[a-f0-9]{16}$" },
    "name": { "type": "string" },
    "owner_engine": { "type": "string" },
    "capability_type": { "type": "string", "enum": ["design", "analysis", "simulation", "verification", "manufacturing", "deployment", "operations", "optimization", "coordination"] },
    "discipline": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["available", "limited", "unavailable", "developmental"] },
    "capacity": { "type": "object", "properties": { "current": { "type": "number" }, "maximum": { "type": "number" } } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "certification": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["capability_id", "name", "owner_engine", "capability_type", "status", "fingerprint"]
}
