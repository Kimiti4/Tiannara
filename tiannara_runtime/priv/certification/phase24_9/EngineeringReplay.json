{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/engineering_replay.json",
  "title": "EngineeringReplay",
  "description": "A deterministic replay event within the CCEIE engineering civilization record.",
  "type": "object",
  "properties": {
    "replay_id": { "type": "string", "pattern": "^ereplay_[a-f0-9]{16}$" },
    "event_type": {
      "type": "string",
      "enum": [
        "ecosystem_state_change", "engineering_decision", "coordination_event",
        "deployment_event", "operations_event", "evolution_transition",
        "certification_event", "governance_decision", "feedback_event",
        "technology_addition", "technology_retirement",
        "ecosystem_participant_change", "integration_update"
      ]
    },
    "input_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "output_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "decision_rationale": { "type": "string" },
    "governance_level": { "type": "string", "enum": ["project", "program", "portfolio", "council", "constitutional"] },
    "certificate_id": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer" },
    "sequence": { "type": "integer" }
  },
  "required": ["replay_id", "event_type", "input_snapshots", "output_snapshots", "content_hash", "timestamp", "sequence"]
}
