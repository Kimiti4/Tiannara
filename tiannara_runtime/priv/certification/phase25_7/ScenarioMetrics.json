{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/scenario_metrics.json",
  "title": "ScenarioMetrics",
  "description": "Health metrics for CMFCSE.",
  "type": "object",
  "properties": {
    "metrics_id": { "type": "string", "pattern": "^fsmet_[a-f0-9]{16}$" },
    "scenario_diversity": { "type": "number" },
    "forecast_stability": { "type": "number" },
    "branch_coverage": { "type": "number" },
    "uncertainty_density": { "type": "number" },
    "prediction_confidence": { "type": "number" },
    "civilizational_readiness": { "type": "number" },
    "technology_readiness": { "type": "number" },
    "future_resilience": { "type": "number" },
    "replay_accuracy": { "type": "number" },
    "constitutional_compliance": { "type": "number" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measured_at": { "type": "integer" }
  },
  "required": ["metrics_id", "scenario_diversity", "forecast_stability", "branch_coverage", "fingerprint"]
}
