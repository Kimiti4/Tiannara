{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/civilization_timeline.json",
  "title": "CivilizationTimeline",
  "description": "A civilizational timeline for a future scenario.",
  "type": "object",
  "properties": {
    "timeline_id": { "type": "string", "pattern": "^ftl_[a-f0-9]{16}$" },
    "scenario_id": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": { "type": "string" },
          "timestamp": { "type": "integer" },
          "event_type": { "type": "string", "enum": ["technology", "science", "infrastructure", "governance", "economic", "social", "environmental", "space", "risk", "intervention"] },
          "description": { "type": "string" },
          "impact": { "type": "object" },
          "probability": { "type": "number" }
        },
        "required": ["event_id", "timestamp", "event_type", "description"]
      }
    },
    "epochs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "epoch_id": { "type": "string" },
          "start_time": { "type": "integer" },
          "end_time": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "kardashev_level": { "type": "number" }
        },
        "required": ["epoch_id", "start_time", "name"]
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "integer" }
  },
  "required": ["timeline_id", "scenario_id", "events", "epochs", "fingerprint"]
}
