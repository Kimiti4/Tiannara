{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/resource_replay.json",
  "title": "ResourceReplay",
  "description": "A deterministic replay event for CPRIE-25.6.",
  "type": "object",
  "properties": {
    "replay_id": { "type": "string", "pattern": "^rereplay_[a-f0-9]{16}$" },
    "event_type": { "type": "string", "enum": ["inventory_replay", "allocation_replay", "forecast_replay", "optimization_replay", "impact_replay", "full_pipeline_replay"] },
    "resource_id": { "type": "string" },
    "target_time": { "type": "integer" },
    "input_snapshot": { "type": "object" },
    "output_snapshot": { "type": "object" },
    "accuracy_verified": { "type": "boolean" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer" }
  },
  "required": ["replay_id", "event_type", "input_snapshot", "output_snapshot", "content_hash"]
}
