{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/resource_metrics.json",
  "title": "ResourceMetrics",
  "description": "Health metrics for CPRIE-25.6.",
  "type": "object",
  "properties": {
    "metrics_id": { "type": "string", "pattern": "^remet_[a-f0-9]{16}$" },
    "resource_availability_index": { "type": "number" },
    "allocation_efficiency": { "type": "number" },
    "waste_reduction": { "type": "number" },
    "sustainability_index": { "type": "number" },
    "strategic_reserve_health": { "type": "number" },
    "resource_diversity": { "type": "number" },
    "recovery_capacity": { "type": "number" },
    "optimization_yield": { "type": "number" },
    "civilizational_resource_readiness": { "type": "number" },
    "replay_accuracy": { "type": "number" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measured_at": { "type": "integer" }
  },
  "required": ["metrics_id", "resource_availability_index", "allocation_efficiency", "sustainability_index", "fingerprint"]
}
