{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/industrial_capability.json",
  "title": "IndustrialCapability",
  "description": "An assessment of industrial ecosystem capabilities for manufacturing.",
  "type": "object",
  "properties": {
    "capability_id": { "type": "string", "pattern": "^icap_[a-f0-9]{16}$" },
    "facility_id": { "type": "string" },
    "assessment": {
      "type": "object",
      "properties": {
        "process_capability": { "type": "number", "minimum": 0, "maximum": 1 },
        "capacity": { "type": "number", "minimum": 0 },
        "quality_history": { "type": "number", "minimum": 0, "maximum": 1 },
        "automation_level": { "type": "number", "minimum": 0, "maximum": 1 },
        "skilled_labor": { "type": "number", "minimum": 0, "maximum": 1 },
        "technology_currency": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["process_capability", "capacity", "quality_history"]
    },
    "capability_index": { "type": "number", "minimum": 0, "maximum": 1 },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assessed_at": { "type": "integer" }
  },
  "required": ["capability_id", "facility_id", "assessment", "fingerprint"]
}
