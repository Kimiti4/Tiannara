{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/manufacturing_replay.json",
  "title": "ManufacturingReplay",
  "description": "A replay event recording a deterministic manufacturing operation.",
  "type": "object",
  "properties": {
    "replay_id": { "type": "string", "pattern": "^mreplay_[a-f0-9]{16}$" },
    "event_type": {
      "type": "string",
      "enum": ["manufacturability_analysis", "process_selection", "supply_chain_configuration", "production_planning", "quality_event", "production_run", "risk_assessment", "sustainability_assessment", "certification"]
    },
    "input_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "output_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "decision_rationale": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer" }
  },
  "required": ["replay_id", "event_type", "input_snapshots", "output_snapshots", "content_hash"]
}
