{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResourceAllocation",
  "description": "Resource allocation decision for a research program",
  "type": "object",
  "properties": {
    "allocation_id": {
      "type": "string",
      "description": "Content-addressed identifier for this allocation"
    },
    "program_id": {
      "type": "string",
      "description": "Program receiving resources"
    },
    "allocation_date": {
      "type": "integer",
      "description": "Constitutional timestamp of allocation"
    },
    "allocation_period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      },
      "required": ["start", "end"]
    },
    "resources": {
      "type": "object",
      "properties": {
        "compute": {
          "type": "number",
          "description": "Compute resource allocation"
        },
        "simulation": {
          "type": "number",
          "description": "Simulation resource allocation"
        },
        "engineering": {
          "type": "number",
          "description": "Engineering resource allocation"
        },
        "laboratory": {
          "type": "number",
          "description": "Laboratory resource allocation"
        },
        "data_collection": {
          "type": "number",
          "description": "Data collection resource allocation"
        },
        "human_review": {
          "type": "number",
          "description": "Human review resource allocation"
        },
        "validation": {
          "type": "number",
          "description": "Validation resource allocation"
        }
      },
      "required": ["compute", "simulation", "engineering", "laboratory"]
    },
    "allocation_priority": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Priority score that drove this allocation"
    },
    "allocation_rationale": {
      "type": "string",
      "description": "Rationale for this allocation"
    },
    "marginal_return": {
      "type": "number",
      "minimum": 0.0,
      "description": "Marginal discovery return of this allocation"
    },
    "constraints_satisfied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Constitutional constraints satisfied by this allocation"
    },
    "governance_approval": {
      "type": "object",
      "properties": {
        "approver": {
          "type": "string"
        },
        "approval_date": {
          "type": "integer"
        },
        "approval_type": {
          "type": "string",
          "enum": ["standard", "expedited", "emergency"]
        }
      },
      "required": ["approver", "approval_date", "approval_type"]
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["allocation_id", "program_id", "allocation_date", "resources", "allocation_priority", "allocation_rationale", "fingerprint"]
}
