{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoveryReturn",
  "description": "Expected discovery return estimate for a resource allocation",
  "type": "object",
  "properties": {
    "return_id": {
      "type": "string",
      "description": "Content-addressed identifier for this return estimate"
    },
    "program_id": {
      "type": "string",
      "description": "Program being assessed"
    },
    "assessment_date": {
      "type": "integer",
      "description": "Constitutional timestamp of assessment"
    },
    "knowledge_gain": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["score", "description", "confidence"]
    },
    "engineering_gain": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["score", "description", "confidence"]
    },
    "cross_domain_benefit": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "domains_benefited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["score", "domains_benefited", "confidence"]
    },
    "future_discovery_multiplier": {
      "type": "object",
      "properties": {
        "multiplier": {
          "type": "number",
          "minimum": 0.0
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["multiplier", "description", "confidence"]
    },
    "risk_reduction": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["score", "description", "confidence"]
    },
    "civilizational_impact": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["score", "description", "confidence"]
    },
    "overall_return_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Composite expected return score"
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["return_id", "program_id", "assessment_date", "knowledge_gain", "engineering_gain", "overall_return_score", "fingerprint"]
}
