{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanetaryIntervention",
  "description": "A planetary-scale intervention with expected and observed outcomes in the planetary feedback integration system",
  "type": "object",
  "properties": {
    "intervention_id": {
      "type": "string",
      "description": "Content-addressed identifier for this intervention"
    },
    "intervention_type": {
      "type": "string",
      "enum": ["scientific", "engineering", "environmental", "governance"],
      "description": "Type of intervention"
    },
    "name": {
      "type": "string",
      "description": "Human-readable intervention name"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the intervention"
    },
    "initiation_date": {
      "type": "integer",
      "description": "Constitutional timestamp of intervention initiation"
    },
    "completion_date": {
      "type": "integer",
      "description": "Constitutional timestamp of intervention completion"
    },
    "expected_outcomes": {
      "type": "object",
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variable": {
                "type": "string"
              },
              "expected_value": {
                "type": "number"
              },
              "uncertainty": {
                "type": "number"
              },
              "timeframe": {
                "type": "string"
              }
            },
            "required": ["variable", "expected_value"]
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["outcomes", "success_criteria"]
    },
    "observed_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variable": {
            "type": "string"
          },
          "observed_value": {
            "type": "number"
          },
          "measurement_date": {
            "type": "integer"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": ["variable", "observed_value", "measurement_date"]
      }
    },
    "deviation_analysis": {
      "type": "object",
      "properties": {
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variable": {
                "type": "string"
              },
              "deviation": {
                "type": "number"
              },
              "significance": {
                "type": "number"
              },
              "attribution": {
                "type": "string",
                "enum": ["model_error", "execution_error", "external_factors", "measurement_error"]
              }
            },
            "required": ["variable", "deviation", "attribution"]
          }
        },
        "overall_effectiveness": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        }
      },
      "required": ["deviations", "overall_effectiveness"]
    },
    "model_updates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Model update references resulting from this intervention"
    },
    "knowledge_updates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Knowledge update references"
    },
    "governance_approval": {
      "type": "object",
      "properties": {
        "approver": {
          "type": "string"
        },
        "approval_date": {
          "type": "integer"
        }
      },
      "required": ["approver", "approval_date"]
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["intervention_id", "intervention_type", "name", "description", "initiation_date", "expected_outcomes", "fingerprint"]
}
