{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngineeringConcept",
  "description": "A novel engineering concept generated by the scientific imagination system",
  "type": "object",
  "properties": {
    "concept_id": {
      "type": "string",
      "description": "Content-addressed identifier for this engineering concept"
    },
    "domain": {
      "type": "string",
      "enum": ["materials", "manufacturing", "energy", "computing", "robotics", "medical", "transportation", "communication", "construction", "other"],
      "description": "Engineering domain"
    },
    "name": {
      "type": "string",
      "description": "Concept name"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the concept"
    },
    "theoretical_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scientific principles involved"
    },
    "engineering_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What is needed to build it"
    },
    "expected_performance": {
      "type": "object",
      "properties": {
        "improvement_factor": {
          "type": "number",
          "minimum": 0.0
        },
        "performance_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "comparison_baseline": {
          "type": "string"
        }
      },
      "required": ["improvement_factor"]
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_type": {
            "type": "string",
            "enum": ["experiment", "simulation", "mathematical_proof", "prototype", "safety_validation"]
          },
          "description": {
            "type": "string"
          },
          "success_criteria": {
            "type": "string"
          }
        },
        "required": ["requirement_type", "description", "success_criteria"]
      }
    },
    "feasibility_rating": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Theoretical feasibility assessment"
    },
    "roadblocks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known roadblocks to implementation"
    },
    "classification": {
      "type": "string",
      "enum": ["plausible", "speculative", "highly_speculative", "counterfactual", "impossible"],
      "description": "Speculation classification"
    },
    "creation_date": {
      "type": "integer",
      "description": "Constitutional timestamp of creation"
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["concept_id", "domain", "name", "description", "feasibility_rating", "classification", "creation_date", "fingerprint"]
}
