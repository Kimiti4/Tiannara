{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OntologyRelation",
  "description": "A relationship between two nodes in the universal ontology",
  "type": "object",
  "properties": {
    "relation_id": {
      "type": "string",
      "description": "Content-addressed identifier for this relationship"
    },
    "relation_type": {
      "type": "string",
      "enum": ["causal", "hierarchical", "temporal", "spatial", "mathematical", "empirical", "cross_domain", "dependency"],
      "description": "Type of relationship"
    },
    "source_node_id": {
      "type": "string",
      "description": "Source concept of the relationship"
    },
    "target_node_id": {
      "type": "string",
      "description": "Target concept of the relationship"
    },
    "direction": {
      "type": "string",
      "enum": ["directed", "bidirectional", "undirected"],
      "description": "Directionality of the relationship"
    },
    "strength": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Relationship strength"
    },
    "description": {
      "type": "string",
      "description": "Description of the relationship"
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence supporting this relationship"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in this relationship"
    },
    "mathematical_formulation": {
      "type": "string",
      "description": "Mathematical formulation if applicable"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "superseded"],
      "description": "Relationship status"
    },
    "creation_date": {
      "type": "integer",
      "description": "Constitutional timestamp of creation"
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["relation_id", "relation_type", "source_node_id", "target_node_id", "direction", "strength", "fingerprint"]
}
