{
  "schema": "COMPRESSION_REPLAY_SCHEMA",
  "version": "22.X.2",
  "description": "Schema for compression replay verification",
  "compression_replay": {
    "fields": {
      "replay_id": {"type": "string", "required": true},
      "compression_artifact_ids": {"type": "array", "required": true},
      "replay_type": {"type": "string", "required": true, "enum": ["knowledge_clustering", "compression_operation", "principle_extraction", "law_discovery", "validation", "full_compression_pipeline"]},
      "replay_timestamp": {"type": "string", "required": true},
      "verification_results": {"type": "object", "required": true},
      "fingerprint_matches": {"type": "boolean", "required": true},
      "divergence_report": {"type": "object", "required": false},
      "fingerprint": {"type": "string", "required": true}
    },
    "constraints": ["deterministic", "verifiable", "replayable"]
  }
}
