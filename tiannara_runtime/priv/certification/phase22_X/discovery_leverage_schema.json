{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoveryLeverage",
  "description": "Discovery leverage assessment for a research program",
  "type": "object",
  "properties": {
    "leverage_id": {
      "type": "string",
      "description": "Content-addressed identifier for this leverage assessment"
    },
    "program_id": {
      "type": "string",
      "description": "Program being assessed"
    },
    "assessment_date": {
      "type": "integer",
      "description": "Constitutional timestamp of assessment"
    },
    "downstream_discoveries": {
      "type": "object",
      "properties": {
        "estimate": {
          "type": "integer",
          "description": "Estimated downstream discoveries enabled"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence in estimate"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": ["estimate", "rationale"]
    },
    "engineering_unlocks": {
      "type": "object",
      "properties": {
        "estimate": {
          "type": "integer",
          "description": "Estimated engineering capabilities unlocked"
        },
        "key_unlocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": ["estimate", "key_unlocks", "rationale"]
    },
    "cross_domain_benefit": {
      "type": "object",
      "properties": {
        "domains_benefited": {
          "type": "integer",
          "description": "Number of domains receiving benefit"
        },
        "benefit_breadth": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Breadth of benefit across domains"
        },
        "primary_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": ["domains_benefited", "benefit_breadth", "primary_domains", "rationale"]
    },
    "uncertainty_reduction": {
      "type": "object",
      "properties": {
        "magnitude": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Uncertainty reduction magnitude"
        },
        "key_uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": ["magnitude", "key_uncertainties", "rationale"]
    },
    "program_acceleration": {
      "type": "object",
      "properties": {
        "programs_accelerated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "average_acceleration": {
          "type": "number",
          "minimum": 0.0,
          "description": "Average timeline compression factor"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": ["programs_accelerated", "average_acceleration", "rationale"]
    },
    "overall_leverage_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Composite discovery leverage score"
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["leverage_id", "program_id", "assessment_date", "downstream_discoveries", "engineering_unlocks", "cross_domain_benefit", "overall_leverage_score", "fingerprint"]
}
