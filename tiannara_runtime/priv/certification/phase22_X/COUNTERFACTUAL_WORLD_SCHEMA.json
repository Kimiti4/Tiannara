{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CounterfactualWorld",
  "description": "A counterfactual scientific world with modified assumptions, physical laws, and mathematical rules",
  "type": "object",
  "properties": {
    "world_id": {
      "type": "string",
      "description": "Content-addressed identifier for this counterfactual world"
    },
    "name": {
      "type": "string",
      "description": "Human-readable world name"
    },
    "description": {
      "type": "string",
      "description": "Description of this counterfactual world"
    },
    "modified_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assumption": {
            "type": "string"
          },
          "standard_value": {
            "type": "string"
          },
          "modified_value": {
            "type": "string"
          },
          "modification_rationale": {
            "type": "string"
          }
        },
        "required": ["assumption", "standard_value", "modified_value"]
      },
      "description": "Scientific assumptions modified in this world"
    },
    "modified_physical_laws": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "law": {
            "type": "string"
          },
          "standard_formulation": {
            "type": "string"
          },
          "modified_formulation": {
            "type": "string"
          }
        },
        "required": ["law", "standard_formulation", "modified_formulation"]
      }
    },
    "modified_mathematical_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "standard_formulation": {
            "type": "string"
          },
          "modified_formulation": {
            "type": "string"
          }
        },
        "required": ["rule", "standard_formulation", "modified_formulation"]
      }
    },
    "modified_initial_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "standard_value": {
            "type": "string"
          },
          "modified_value": {
            "type": "string"
          }
        },
        "required": ["condition", "standard_value", "modified_value"]
      }
    },
    "expected_consequences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phenomenon": {
            "type": "string"
          },
          "predicted_difference": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": ["phenomenon", "predicted_difference"]
      }
    },
    "testable_implications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empirically distinguishable predictions"
    },
    "motivating_gap": {
      "type": "string",
      "description": "Knowledge gap driving this counterfactual exploration"
    },
    "classification": {
      "type": "string",
      "enum": ["counterfactual", "impossible"],
      "description": "Speculation classification"
    },
    "creation_date": {
      "type": "integer",
      "description": "Constitutional timestamp of creation"
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["world_id", "name", "description", "modified_assumptions", "classification", "creation_date", "fingerprint"]
}
