{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanetaryObservation",
  "description": "A planetary-scale observation in the planetary feedback integration system",
  "type": "object",
  "properties": {
    "observation_id": {
      "type": "string",
      "description": "Content-addressed identifier for this observation"
    },
    "layer": {
      "type": "string",
      "enum": ["planetary_physics", "climate", "atmosphere", "hydrology", "geology", "ecology", "agriculture", "energy_infrastructure", "transportation", "economy", "civilizations", "scientific_infrastructure"],
      "description": "Observation layer"
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "altitude": {
          "type": "number"
        },
        "region": {
          "type": "string"
        }
      },
      "required": ["latitude", "longitude"]
    },
    "time": {
      "type": "integer",
      "description": "Constitutional timestamp of observation"
    },
    "measured_variables": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Observed quantities and their values"
    },
    "sensor_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sensor_id": {
            "type": "string"
          },
          "sensor_type": {
            "type": "string"
          },
          "measurement_quality": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": ["sensor_id", "sensor_type"]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Overall measurement confidence"
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Uncertainty bounds per measured variable"
    },
    "data_quality_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Data quality assessment score"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prerequisite observation IDs"
    },
    "fusion_info": {
      "type": "object",
      "properties": {
        "fused": {
          "type": "boolean"
        },
        "source_observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["observation_id", "layer", "location", "time", "measured_variables", "sensor_sources", "confidence", "fingerprint"]
}
