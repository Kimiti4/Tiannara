{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Theory",
  "description": "A scientific theory represented as a constitutional artifact in the theory ecosystem",
  "type": "object",
  "properties": {
    "theory_id": {
      "type": "string",
      "description": "Content-addressed identifier for this theory"
    },
    "name": {
      "type": "string",
      "description": "Human-readable theory name"
    },
    "theory_type": {
      "type": "string",
      "enum": ["hypothesis", "candidate", "validated", "competing", "dominant", "specialized", "unified", "historical"]
    },
    "scope": {
      "type": "string",
      "description": "Domain scope of the theory"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Core assumptions underlying the theory"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string",
            "enum": ["observation", "experimental", "predictive", "mathematical", "engineering"]
          },
          "support_direction": {
            "type": "string",
            "enum": ["supporting", "contradicting", "neutral"]
          }
        },
        "required": ["evidence_id", "evidence_type", "support_direction"]
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prediction_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "accuracy": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": ["prediction_id", "description"]
      }
    },
    "mathematical_basis": {
      "type": "string",
      "description": "Mathematical formalism underlying the theory"
    },
    "engineering_utility": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Demonstrated engineering utility"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Current confidence in the theory"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence or predictions contradicting this theory"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Theories this theory depends on"
    },
    "parent_theories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Theories from which this theory evolved or specialized"
    },
    "child_theories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Theories evolved or specialized from this theory"
    },
    "replay_root": {
      "type": "string",
      "description": "Reference to the replay root for this theory"
    },
    "archaeology_root": {
      "type": "string",
      "description": "Reference to the archaeology root for this theory"
    },
    "version": {
      "type": "integer",
      "description": "Theory version number"
    },
    "registration_date": {
      "type": "integer",
      "description": "Constitutional timestamp of registration"
    },
    "last_updated": {
      "type": "integer",
      "description": "Constitutional timestamp of last update"
    },
    "status": {
      "type": "string",
      "enum": ["active", "competing", "dominant", "specialized", "historical"]
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["theory_id", "name", "theory_type", "scope", "confidence", "registration_date", "fingerprint"]
}
