{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScientificHypothesis",
  "description": "A generated scientific hypothesis with testable predictions",
  "type": "object",
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "description": "Content-addressed identifier for this hypothesis"
    },
    "question": {
      "type": "string",
      "description": "The scientific question addressed"
    },
    "statement": {
      "type": "string",
      "description": "Hypothesis statement"
    },
    "source_type": {
      "type": "string",
      "enum": ["knowledge_gap", "theory_driven", "observation_driven", "counterfactual_driven"],
      "description": "Source of the hypothesis"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Underlying assumptions"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prediction": {
            "type": "string"
          },
          "testability": {
            "type": "string",
            "enum": ["immediately_testable", "requires_experiment", "requires_technology", "theoretical"]
          },
          "falsifiable": {
            "type": "boolean"
          }
        },
        "required": ["prediction", "testability"]
      }
    },
    "supporting_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Existing knowledge supporting the hypothesis"
    },
    "contradicting_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Existing knowledge that may contradict"
    },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What evidence would confirm or falsify"
    },
    "scientific_domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "novelty_assessment": {
      "type": "object",
      "properties": {
        "novelty_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "paradigm_challenging": {
          "type": "boolean"
        },
        "cross_domain_novel": {
          "type": "boolean"
        }
      },
      "required": ["novelty_score"]
    },
    "plausibility_assessment": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Initial plausibility assessment"
    },
    "classification": {
      "type": "string",
      "enum": ["validated", "highly_supported", "plausible", "speculative", "highly_speculative"],
      "description": "Speculation classification"
    },
    "creation_date": {
      "type": "integer",
      "description": "Constitutional timestamp of creation"
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["hypothesis_id", "question", "statement", "source_type", "predictions", "scientific_domains", "classification", "creation_date", "fingerprint"]
}
