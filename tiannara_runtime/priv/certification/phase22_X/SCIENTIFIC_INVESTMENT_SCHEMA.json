{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScientificInvestment",
  "description": "Strategic scientific investment record in the discovery economics system",
  "type": "object",
  "properties": {
    "investment_id": {
      "type": "string",
      "description": "Content-addressed identifier for this investment"
    },
    "scientific_goal": {
      "type": "string",
      "description": "Clear statement of the scientific objective"
    },
    "program_id": {
      "type": "string",
      "description": "Program receiving the investment"
    },
    "investment_type": {
      "type": "string",
      "enum": ["short_term", "medium_term", "long_term"],
      "description": "Investment time horizon"
    },
    "investment_date": {
      "type": "integer",
      "description": "Constitutional timestamp of investment"
    },
    "allocated_resources": {
      "type": "object",
      "properties": {
        "compute": {
          "type": "number"
        },
        "simulation": {
          "type": "number"
        },
        "engineering": {
          "type": "number"
        },
        "laboratory": {
          "type": "number"
        },
        "observation": {
          "type": "number"
        },
        "human_review": {
          "type": "number"
        },
        "energy": {
          "type": "number"
        },
        "knowledge_processing": {
          "type": "number"
        }
      },
      "required": ["compute", "simulation", "engineering", "laboratory"]
    },
    "expected_return": {
      "type": "object",
      "properties": {
        "knowledge_gain": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "engineering_gain": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "cross_domain_benefit": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "future_discovery_multiplier": {
          "type": "number",
          "minimum": 0.0
        },
        "risk_reduction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "civilizational_impact": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["knowledge_gain", "engineering_gain"]
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "technical_risk": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "hypothesis_risk": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "resource_overrun_risk": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "opportunity_cost_risk": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "overall_risk": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": ["overall_risk"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in expected return estimate"
    },
    "timeframe": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "expected_completion": {
          "type": "integer"
        },
        "actual_completion": {
          "type": "integer"
        }
      },
      "required": ["start", "expected_completion"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "underperforming", "restructured", "terminated"]
    },
    "governance_approval": {
      "type": "object",
      "properties": {
        "approver": {
          "type": "string"
        },
        "approval_date": {
          "type": "integer"
        }
      },
      "required": ["approver", "approval_date"]
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash"
    }
  },
  "required": ["investment_id", "scientific_goal", "program_id", "investment_type", "investment_date", "allocated_resources", "expected_return", "risk_assessment", "fingerprint"]
}
