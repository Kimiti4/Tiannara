{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanetaryReplay",
  "description": "Deterministic replay verification record for planetary feedback integration",
  "type": "object",
  "properties": {
    "replay_id": {
      "type": "string",
      "description": "Content-addressed identifier for this replay verification"
    },
    "replay_date": {
      "type": "integer",
      "description": "Constitutional timestamp of replay"
    },
    "replay_scope": {
      "type": "string",
      "enum": ["single_observation", "state_reconciliation", "health_assessment", "intervention_feedback", "adaptation", "planetary_period"]
    },
    "operation_type": {
      "type": "string",
      "enum": ["observation_fusion", "state_reconciliation", "health_evaluation", "intervention_feedback", "model_adaptation"]
    },
    "operation_reference": {
      "type": "string",
      "description": "Reference to the original operation record"
    },
    "original_state": {
      "type": "object",
      "properties": {
        "state_id": {
          "type": "string"
        },
        "state_hash": {
          "type": "string"
        }
      },
      "required": ["state_id", "state_hash"]
    },
    "replayed_state": {
      "type": "object",
      "properties": {
        "state_id": {
          "type": "string"
        },
        "state_hash": {
          "type": "string"
        }
      },
      "required": ["state_id", "state_hash"]
    },
    "hash_match": {
      "type": "boolean",
      "description": "Whether original and replayed hashes match"
    },
    "lineage_verification": {
      "type": "object",
      "properties": {
        "lineage_complete": {
          "type": "boolean"
        },
        "lineage_consistent": {
          "type": "boolean"
        },
        "missing_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["lineage_complete", "lineage_consistent"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "hash_mismatch", "lineage_break", "incomplete"]
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic content hash of this replay record"
    }
  },
  "required": ["replay_id", "replay_date", "replay_scope", "operation_reference", "original_state", "replayed_state", "hash_match", "verification_status", "fingerprint"]
}
