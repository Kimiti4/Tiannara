{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/program_certificate.json",
  "title": "ProgramCertificate",
  "description": "Certification attesting that a program or portfolio element meets constitutional standards.",
  "type": "object",
  "properties": {
    "certificate_id": { "type": "string", "pattern": "^pcert_[a-f0-9]{16}$" },
    "entity_id": { "type": "string" },
    "entity_type": { "type": "string", "enum": ["program", "project", "milestone", "deliverable", "portfolio", "resource_allocation"] },
    "certification_type": { "type": "string", "enum": ["program", "project", "milestone", "deliverable", "portfolio", "resource"] },
    "checks": {
      "type": "object",
      "properties": {
        "constitutional_alignment": { "type": "boolean" },
        "resource_adequacy": { "type": "boolean" },
        "schedule_feasibility": { "type": "boolean" },
        "risk_acceptance": { "type": "boolean" },
        "dependency_resolution": { "type": "boolean" },
        "quality_standards": { "type": "boolean" }
      },
      "required": ["constitutional_alignment", "resource_adequacy", "risk_acceptance"]
    },
    "certifying_entity": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certified_at": { "type": "integer" }
  },
  "required": ["certificate_id", "entity_id", "entity_type", "certification_type", "checks", "fingerprint"]
}
