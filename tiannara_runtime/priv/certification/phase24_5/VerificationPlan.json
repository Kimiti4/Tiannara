{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/verification_plan.json",
  "title": "VerificationPlan",
  "description": "A constitutional verification plan linking requirements to verification methods and evidence.",
  "type": "object",
  "properties": {
    "plan_id": { "type": "string", "pattern": "^vvplan_[a-f0-9]{16}$" },
    "system_id": { "type": "string" },
    "verification_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": { "type": "string" },
          "method": { "type": "string", "enum": ["test", "analysis", "demonstration", "inspection", "review", "formal_proof"] },
          "level": { "type": "string", "enum": ["unit", "integration", "system", "acceptance", "operational"] },
          "environment": { "type": "string" },
          "expected_result": { "type": "string" },
          "status": { "type": "string", "enum": ["planned", "in_progress", "passed", "failed", "blocked"] },
          "evidence_id": { "type": "string" }
        },
        "required": ["requirement_id", "method", "level", "expected_result", "status"]
      }
    },
    "coverage_metrics": { "type": "object", "properties": { "total": { "type": "integer" }, "verified": { "type": "integer" }, "not_verified": { "type": "integer" }, "coverage_pct": { "type": "number" } } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["plan_id", "system_id", "verification_items", "fingerprint"]
}
