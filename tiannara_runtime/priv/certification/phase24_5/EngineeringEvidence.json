{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/engineering_evidence.json",
  "title": "EngineeringEvidence",
  "description": "Immutable engineering evidence supporting verification, validation, or qualification.",
  "type": "object",
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^evid_[a-f0-9]{16}$" },
    "evidence_type": { "type": "string", "enum": ["measurement", "inspection", "simulation", "physical_test", "review", "analysis", "certification"] },
    "requirement_id": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": {
      "type": "object",
      "properties": {
        "collected_by": { "type": "string" },
        "collection_method": { "type": "string" },
        "environment": { "type": "string" },
        "timestamp": { "type": "integer" },
        "configuration_id": { "type": "string" }
      },
      "required": ["collected_by", "timestamp"]
    },
    "result": { "type": "string", "enum": ["pass", "fail", "inconclusive"] },
    "value": { "type": "string" },
    "uncertainty": { "type": "number" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "collected_at": { "type": "integer" }
  },
  "required": ["evidence_id", "evidence_type", "content_hash", "provenance", "result", "fingerprint"]
}
