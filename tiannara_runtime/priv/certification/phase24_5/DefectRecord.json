{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/defect_record.json",
  "title": "DefectRecord",
  "description": "A constitutional defect record tracking a failure from discovery to closure.",
  "type": "object",
  "properties": {
    "defect_id": { "type": "string", "pattern": "^defect_[a-f0-9]{16}$" },
    "system_id": { "type": "string" },
    "description": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor", "cosmetic"] },
    "status": { "type": "string", "enum": ["open", "analysis", "corrective_action", "verification", "closed"] },
    "found_in_version": { "type": "string" },
    "found_in_phase": { "type": "string" },
    "found_by": { "type": "string" },
    "root_cause": { "type": "string" },
    "root_cause_method": { "type": "string" },
    "corrective_action": { "type": "string" },
    "verification_evidence_id": { "type": "string" },
    "closure_notes": { "type": "string" },
    "related_defect_ids": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" },
    "closed_at": { "type": "integer" }
  },
  "required": ["defect_id", "system_id", "description", "severity", "status", "fingerprint"]
}
