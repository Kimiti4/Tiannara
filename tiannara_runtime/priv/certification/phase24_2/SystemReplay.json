{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/system_replay.json",
  "title": "SystemReplay",
  "description": "A replay event recording a deterministic systems engineering operation.",
  "type": "object",
  "properties": {
    "replay_id": { "type": "string", "pattern": "^sreplay_[a-f0-9]{16}$" },
    "event_type": {
      "type": "string",
      "enum": ["mission_definition", "requirement_creation", "functional_decomposition", "architecture_definition", "subsystem_allocation", "interface_definition", "integration_step", "verification_activity", "validation_activity", "acceptance_decision", "baseline_creation", "change_implementation", "certification"]
    },
    "input_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "output_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "decision_rationale": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer" }
  },
  "required": ["replay_id", "event_type", "input_snapshots", "output_snapshots", "content_hash"]
}
