{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/impact_prediction.json",
  "title": "ImpactPrediction",
  "description": "A constitutional prediction of the impact of a scientific discovery.",
  "type": "object",
  "properties": {
    "prediction_id": { "type": "string", "pattern": "^ip_[a-f0-9]{16}$" },
    "discovery_id": { "type": "string" },
    "impact_graph": { "type": "object" },
    "scenario_id": { "type": "string" },
    "domain": { "type": "string", "enum": ["scientific", "engineering", "economic", "societal", "planetary", "civilizational"] },
    "prediction_type": { "type": "string", "enum": ["direct_effect", "second_order", "third_order", "scenario_aggregate", "risk_assessment", "opportunity_assessment", "domain_forecast", "priority_score"] },
    "predicted_effect": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "object", "properties": { "epistemic": { "type": "number" }, "aleatoric": { "type": "number" }, "model": { "type": "number" } } },
    "causal_chain": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "supporting_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "predicted_at": { "type": "integer" }
  },
  "required": ["prediction_id", "discovery_id", "domain", "prediction_type", "predicted_effect", "confidence", "causal_chain", "fingerprint"]
}
