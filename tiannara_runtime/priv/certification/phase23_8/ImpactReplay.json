{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/impact_replay.json",
  "title": "ImpactReplay",
  "description": "A replay event recording a deterministic impact prediction operation.",
  "type": "object",
  "properties": {
    "replay_id": { "type": "string", "pattern": "^ireplay_[a-f0-9]{16}$" },
    "event_type": {
      "type": "string",
      "enum": ["impact_identification", "causal_propagation", "scenario_generation", "risk_assessment", "opportunity_assessment", "domain_forecast", "priority_computation", "certification"]
    },
    "input_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "output_snapshots": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "entity_type": { "type": "string" }, "snapshot": { "type": "object" } }, "required": ["entity_id", "entity_type", "snapshot"] } },
    "algorithm_parameters": { "type": "object" },
    "deterministic_seed": { "type": "integer" },
    "parent_event_ids": { "type": "array", "items": { "type": "string" } },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer" }
  },
  "required": ["replay_id", "event_type", "input_snapshots", "output_snapshots", "content_hash"]
}
