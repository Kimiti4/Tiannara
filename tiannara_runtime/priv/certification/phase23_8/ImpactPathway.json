{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/impact_pathway.json",
  "title": "ImpactPathway",
  "description": "A causal pathway from a discovery through propagation orders to a predicted outcome.",
  "type": "object",
  "properties": {
    "pathway_id": { "type": "string", "pattern": "^ipath_[a-f0-9]{16}$" },
    "discovery_id": { "type": "string" },
    "prediction_id": { "type": "string" },
    "propagation_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": { "type": "integer", "minimum": 0 },
          "effect_description": { "type": "string" },
          "affected_system": { "type": "string" },
          "effect_type": { "type": "string", "enum": ["direct", "indirect", "feedback", "emergent", "cascade", "nonlinear"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["order", "effect_description", "affected_system", "effect_type", "confidence"]
      }
    },
    "amplification_factor": { "type": "number" },
    "damping_factor": { "type": "number" },
    "pathway_type": { "type": "string", "enum": ["linear", "branching", "converging", "cyclic", "mixed"] },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["pathway_id", "discovery_id", "propagation_chain", "fingerprint"]
}
