{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/digital_trace.json",
  "title": "DigitalTrace",
  "description": "A traceability link between digital engineering artifacts.",
  "type": "object",
  "properties": {
    "trace_id": { "type": "string", "pattern": "^dtrace_[a-f0-9]{16}$" },
    "source_type": { "type": "string", "enum": ["requirement", "function", "subsystem", "model", "verification", "certificate", "asset"] },
    "source_id": { "type": "string" },
    "target_type": { "type": "string", "enum": ["requirement", "function", "subsystem", "model", "verification", "certificate", "asset"] },
    "target_id": { "type": "string" },
    "relationship": { "type": "string", "enum": ["derives_from", "satisfies", "implements", "verifies", "certifies", "depends_on", "composes"] },
    "strength": { "type": "string", "enum": ["direct", "indirect", "partial"] },
    "verified": { "type": "boolean" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["trace_id", "source_type", "source_id", "target_type", "target_id", "relationship", "fingerprint"]
}
