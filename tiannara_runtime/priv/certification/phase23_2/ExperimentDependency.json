{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentDependency",
  "description": "A directed edge in the experiment dependency DAG representing a prerequisite relationship between two experiments",
  "type": "object",
  "properties": {
    "dependency_id": {
      "type": "string",
      "description": "Content-addressed unique identifier for this dependency edge"
    },
    "source_experiment_id": {
      "type": "string",
      "description": "The prerequisite experiment that must complete first"
    },
    "target_experiment_id": {
      "type": "string",
      "description": "The dependent experiment that requires the source"
    },
    "dependency_type": {
      "type": "string",
      "enum": ["hard", "soft", "optional", "cross_domain", "simulation_first", "validation"],
      "description": "Type of dependency constraint"
    },
    "rationale": {
      "type": "string",
      "description": "Why this dependency exists"
    },
    "strength": {
      "type": "number",
      "description": "Dependency strength (0.0-1.0) for soft dependencies"
    },
    "domain": {
      "type": "string",
      "description": "Domain context for cross-domain dependencies"
    },
    "created_at": { "type": "integer" },
    "dependency_hash": { "type": "string" }
  },
  "required": [
    "dependency_id", "source_experiment_id", "target_experiment_id",
    "dependency_type", "rationale", "created_at", "dependency_hash"
  ],
  "additionalProperties": false
}
