{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/scientific_consensus.json",
  "title": "ScientificConsensus",
  "description": "Consensus among collaboration participants on a scientific question.",
  "type": "object",
  "properties": {
    "consensus_id": { "type": "string", "pattern": "^scons_[a-f0-9]{16}$" },
    "collaboration_id": { "type": "string" },
    "question": { "type": "string" },
    "consensus_state": { "type": "string", "enum": ["unanimous", "majority", "weighted", "expert", "no_consensus", "minority_position"] },
    "participant_positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "participant_id": { "type": "string" },
          "position": { "type": "string" },
          "evidence": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "minority_positions": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["consensus_id", "collaboration_id", "question", "consensus_state", "fingerprint"]
}
