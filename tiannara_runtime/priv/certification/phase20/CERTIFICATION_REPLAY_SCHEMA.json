{
  "schema": "CERTIFICATION_REPLAY_SCHEMA",
  "version": "20.999",
  "description": "Schema for certification replay — reconstructs the complete certification process deterministically",
  "certification_replay": {
    "fields": {
      "replay_id": {"type": "string", "required": true, "description": "Content-addressed replay identifier"},
      "csos_version": {"type": "string", "required": true, "description": "CSOS 1.0"},
      "replay_type": {"type": "string", "required": true, "description": "FullCertification/Decision/Freeze/Archive/Baseline/Certificate"},
      "steps": {
        "type": "array", "required": true,
        "items": {
          "type": "object",
          "fields": {
            "step": {"type": "integer"}, "stage": {"type": "string"},
            "input_hash": {"type": "string"}, "output_hash": {"type": "string"},
            "step_hash": {"type": "string"}
          }
        }
      },
      "root_hash_original": {"type": "string", "required": true},
      "root_hash_reconstructed": {"type": "string", "required": true},
      "all_hashes_match": {"type": "boolean", "required": true},
      "certification_decision_replayed": {"type": "boolean", "required": true},
      "freeze_replayed": {"type": "boolean", "required": true},
      "archive_replayed": {"type": "boolean", "required": true},
      "baseline_generated": {"type": "boolean", "required": true},
      "certificate_generated": {"type": "boolean", "required": true},
      "status": {"type": "string", "required": true, "description": "Pending/Verified/Failed"},
      "fingerprint": {"type": "string", "required": true}
    },
    "constraints": ["deterministic_replay", "identical_hashes_required", "cold_storage_independent"]
  }
}