{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/risk_scenario.json",
  "title": "RiskScenario",
  "description": "A risk scenario generated by the CPRIE.",
  "type": "object",
  "properties": {
    "scenario_id": { "type": "string", "pattern": "^rscene_[a-f0-9]{16}$" },
    "risk_id": { "type": "string" },
    "description": { "type": "string" },
    "trigger_conditions": { "type": "object" },
    "propagation_path": { "type": "array", "items": { "type": "object", "properties": { "stage": { "type": "integer" }, "affected_domain": { "type": "string" }, "impact": { "type": "object" }, "probability": { "type": "number" }, "time_delay": { "type": "string" } } } },
    "expected_outcomes": { "type": "object" },
    "worst_case": { "type": "object" },
    "best_case": { "type": "object" },
    "uncertainty": { "type": "object" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "integer" }
  },
  "required": ["scenario_id", "risk_id", "description", "propagation_path", "fingerprint"]
}
