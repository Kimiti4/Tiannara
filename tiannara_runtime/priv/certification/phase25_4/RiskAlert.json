{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/risk_alert.json",
  "title": "RiskAlert",
  "description": "An alert generated by the CPRIE for a detected risk.",
  "type": "object",
  "properties": {
    "alert_id": { "type": "string", "pattern": "^ralert_[a-f0-9]{16}$" },
    "risk_id": { "type": "string" },
    "alert_level": { "type": "string", "enum": ["info", "warning", "critical", "emergency"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "trigger_conditions": { "type": "string" },
    "affected_domains": { "type": "array", "items": { "type": "string" } },
    "affected_regions": { "type": "array", "items": { "type": "string" } },
    "recommended_action": { "type": "string" },
    "escalation_level": { "type": "string", "enum": ["program", "council", "planetary"] },
    "acknowledged": { "type": "boolean" },
    "acknowledged_by": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "integer" }
  },
  "required": ["alert_id", "risk_id", "alert_level", "title", "description", "fingerprint"]
}
