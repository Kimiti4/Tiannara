{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/alert.json",
  "title": "Alert",
  "description": "An alert generated by the Constitutional Planetary Observatory.",
  "type": "object",
  "properties": {
    "alert_id": { "type": "string", "pattern": "^obalert_[a-f0-9]{16}$" },
    "level": { "type": "string", "enum": ["informational", "advisory", "warning", "critical", "constitutional_emergency"] },
    "source": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "evidence_links": { "type": "array", "items": { "type": "string" } },
    "replay_link": { "type": "string" },
    "suggested_response": { "type": "string" },
    "acknowledged": { "type": "boolean" },
    "acknowledged_by": { "type": "string" },
    "acknowledged_at": { "type": "integer" },
    "resolved": { "type": "boolean" },
    "resolved_at": { "type": "integer" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "integer" }
  },
  "required": ["alert_id", "level", "title", "description", "fingerprint"]
}
