{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/infrastructure_dependency.json",
  "title": "InfrastructureDependency",
  "description": "A dependency relationship between infrastructure systems or components.",
  "type": "object",
  "properties": {
    "dependency_id": { "type": "string", "pattern": "^idep_[a-f0-9]{16}$" },
    "source_system_id": { "type": "string" },
    "target_system_id": { "type": "string" },
    "dependency_type": { "type": "string", "enum": ["physical", "information", "energy", "communication", "logistical", "scientific", "industrial", "human"] },
    "criticality": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "cascade_potential": { "type": "number", "minimum": 0, "maximum": 1 },
    "redundancy_available": { "type": "boolean" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mapped_at": { "type": "integer" }
  },
  "required": ["dependency_id", "source_system_id", "target_system_id", "dependency_type", "fingerprint"]
}
