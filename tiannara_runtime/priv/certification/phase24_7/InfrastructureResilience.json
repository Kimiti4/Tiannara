{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/infrastructure_resilience.json",
  "title": "InfrastructureResilience",
  "description": "A resilience assessment for an infrastructure system.",
  "type": "object",
  "properties": {
    "resilience_id": { "type": "string", "pattern": "^ires_[a-f0-9]{16}$" },
    "infrastructure_id": { "type": "string" },
    "dimensions": {
      "type": "object",
      "properties": {
        "robustness": { "type": "number", "minimum": 0, "maximum": 1 },
        "redundancy": { "type": "number", "minimum": 0, "maximum": 1 },
        "resourcefulness": { "type": "number", "minimum": 0, "maximum": 1 },
        "response": { "type": "number", "minimum": 0, "maximum": 1 },
        "recovery": { "type": "number", "minimum": 0, "maximum": 1 },
        "adaptation": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["robustness", "redundancy", "recovery"]
    },
    "resilience_index": { "type": "number", "minimum": 0, "maximum": 1 },
    "threats_assessed": { "type": "array", "items": { "type": "string" } },
    "improvement_recommendations": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assessed_at": { "type": "integer" }
  },
  "required": ["resilience_id", "infrastructure_id", "dimensions", "fingerprint"]
}
