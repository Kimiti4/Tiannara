{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/infrastructure_certificate.json",
  "title": "InfrastructureCertificate",
  "description": "Certification attesting that an infrastructure system meets constitutional standards.",
  "type": "object",
  "properties": {
    "certificate_id": { "type": "string", "pattern": "^icert_[a-f0-9]{16}$" },
    "infrastructure_id": { "type": "string" },
    "certification_type": { "type": "string", "enum": ["component", "network", "system_of_systems", "resilience", "interoperability", "safety", "evolution"] },
    "checks": {
      "type": "object",
      "properties": {
        "safety_compliance": { "type": "boolean" },
        "resilience_adequacy": { "type": "boolean" },
        "interoperability": { "type": "boolean" },
        "dependency_coverage": { "type": "boolean" },
        "environmental_compliance": { "type": "boolean" },
        "constitutional_alignment": { "type": "boolean" }
      },
      "required": ["safety_compliance", "resilience_adequacy", "constitutional_alignment"]
    },
    "certifying_entity": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certified_at": { "type": "integer" }
  },
  "required": ["certificate_id", "infrastructure_id", "certification_type", "checks", "fingerprint"]
}
