{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/challenge_certificate.json",
  "title": "ChallengeCertificate",
  "description": "Certification for CDCIE or its components.",
  "type": "object",
  "properties": {
    "certificate_id": { "type": "string", "pattern": "^dccert_[a-f0-9]{16}$" },
    "entity_id": { "type": "string" },
    "entity_type": { "type": "string", "enum": ["cdcie", "challenge_registry", "classification_engine", "priority_engine", "routing_engine", "lifecycle_engine", "knowledge_gap_engine"] },
    "certification_type": { "type": "string", "enum": ["architecture", "registry", "classification", "priority", "routing", "lifecycle", "knowledge_gap", "replay", "data"] },
    "checks": {
      "type": "object",
      "properties": {
        "constitutional_compliant": { "type": "boolean" },
        "deterministic": { "type": "boolean" },
        "replayable": { "type": "boolean" },
        "append_only": { "type": "boolean" },
        "evidence_traceable": { "type": "boolean" }
      },
      "required": ["constitutional_compliant", "deterministic", "replayable", "append_only"]
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certified_at": { "type": "integer" }
  },
  "required": ["certificate_id", "entity_id", "entity_type", "certification_type", "checks", "fingerprint"]
}
