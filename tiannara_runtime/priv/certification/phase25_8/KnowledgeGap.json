{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/knowledge_gap.json",
  "title": "KnowledgeGap",
  "description": "A structured knowledge gap record.",
  "type": "object",
  "properties": {
    "gap_id": { "type": "string", "pattern": "^kg_[a-f0-9]{16}$" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "gap_type": { "type": "string", "enum": ["empirical", "theoretical", "methodological", "integration"] },
    "importance": { "type": "number", "minimum": 0, "maximum": 1 },
    "related_challenges": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "difficulty": { "type": "string" },
    "closure_progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["open", "partially_closed", "closed", "superseded"] },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identified_at": { "type": "integer" },
    "closed_at": { "type": "integer" }
  },
  "required": ["gap_id", "domain", "description", "gap_type", "status", "fingerprint"]
}
