{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/runtime_checkpoint.json",
  "title": "RuntimeCheckpoint",
  "description": "A deterministic checkpoint of the planetary runtime state.",
  "type": "object",
  "properties": {
    "checkpoint_id": { "type": "string", "pattern": "^chk_[a-f0-9]{16}$" },
    "sequence": { "type": "integer" },
    "parent_checkpoint_id": { "type": "string" },
    "global_state_hash": { "type": "string" },
    "domain_state_hashes": { "type": "object" },
    "event_log_position": { "type": "integer" },
    "runtime_config_hash": { "type": "string" },
    "subsystem_states": { "type": "object" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string" },
    "checkpoint_type": { "type": "string", "enum": ["regular", "periodic", "event_driven", "pre_operation", "post_operation", "emergency"] },
    "verified": { "type": "boolean" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "integer" }
  },
  "required": ["checkpoint_id", "sequence", "global_state_hash", "event_log_position", "content_hash", "fingerprint"]
}
