{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/runtime_metrics.json",
  "title": "RuntimeMetrics",
  "description": "Metrics for the planetary runtime health and performance.",
  "type": "object",
  "properties": {
    "metrics_id": { "type": "string", "pattern": "^rmet_[a-f0-9]{16}$" },
    "availability": {
      "type": "object",
      "properties": {
        "runtime_availability": { "type": "number" },
        "checkpoint_success_rate": { "type": "number" },
        "recovery_success_rate": { "type": "number" },
        "replay_success_rate": { "type": "number" }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "event_throughput": { "type": "number" },
        "pipeline_latency_ms": { "type": "number" },
        "synchronization_latency_ms": { "type": "number" },
        "checkpoint_duration_ms": { "type": "number" },
        "recovery_time_ms": { "type": "number" }
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "checkpoint_integrity": { "type": "number" },
        "replay_accuracy": { "type": "number" },
        "constitutional_compliance_rate": { "type": "number" }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measured_at": { "type": "integer" }
  },
  "required": ["metrics_id", "availability", "performance", "integrity", "fingerprint"]
}
