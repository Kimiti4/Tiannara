{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiannara.ai/schemas/runtime_state.json",
  "title": "RuntimeState",
  "description": "The complete runtime state of the CPR at a point in time.",
  "type": "object",
  "properties": {
    "runtime_id": { "type": "string" },
    "state_machine_state": { "type": "string" },
    "active_subdomain_count": { "type": "integer" },
    "subsystems": { "type": "object" },
    "current_checkpoint_id": { "type": "string" },
    "last_event_sequence": { "type": "integer" },
    "logical_clock": { "type": "integer" },
    "pipeline_status": { "type": "string", "enum": ["idle", "running", "blocked", "recovering", "archiving"] },
    "health_status": { "type": "object" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot_at": { "type": "integer" }
  },
  "required": ["runtime_id", "state_machine_state", "health_status", "fingerprint"]
}
