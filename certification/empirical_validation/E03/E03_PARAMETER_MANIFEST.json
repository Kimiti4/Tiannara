    "code_revision", "parameter_hash", "input_hash", "output_hash",
    "measurement_version", "timestamp"
  ],

  "run_id_computation": "sha256(campaign_id | experiment_id | seed | config_hash | code_revision)",

  "no_trust_verification": {
