  "hypotheses": {
    "H1_primary": "A bounded stabilizer regime can prevent catastrophic ecological collapse while preserving measurable adaptive emergence, diversity, novelty, and evolutionary exploration.",
    "H0_A_suffocation": "Stabilization suppresses evolutionary freedom sufficiently that diversity, novelty, adaptation, or exploration decline toward artificial equilibrium.",
    "H0_B_ineffectiveness": "Stabilization fails to prevent ecological collapse.",
    "H0_C_artificial_emergence": "Apparent emergence is generated primarily by the stabilizer itself rather than by autonomous ecological dynamics."
  },

  "emergence_classification_vocabulary": [
    "ENDOGENOUS", "STABILIZER_ASSISTED", "STABILIZER_INDUCED", "ARTIFICIAL_NON_EMERGENT", "UNRESOLVED"
  ],

  "conditions": [
    {
      "condition": "CONTROL_A",
      "description": "Unregulated baseline (stabilizer OFF)",
      "stabilizer_state": "OFF",
      "purpose": "Reference: what the ecology does on its own"
    },
    {
      "condition": "CONTROL_B",
      "description": "Stabilizer-only regime (minimum effective pressure to be identified by §13 sweep)",
      "stabilizer_state": "ON",
      "stabilizer_pressure": "TBD_BY_PRESSURE_SWEEP",
      "purpose": "Test H1"
    },
    {
      "condition": "CONTROL_C",
      "description": "Reduced/intermediate stabilization (half pressure of B)",
      "stabilizer_state": "ON",
      "stabilizer_pressure": "0.5",
      "purpose": "Test H0-A and H1 gradient"
    }
  ],

  "seed_policy": {
    "all_seeds_preregistered": true,
    "discard_inconvenient_seeds": false,
    "rerun_until_desired_result": false,
    "all_runs_belong_in_ledger": true
  },

  "seeds": [
    {"run": "E03-A-001", "condition": "CONTROL_A", "seed": 42,        "seed_label": "A-001", "notes": "Independent seed"},
    {"run": "E03-A-002", "condition": "CONTROL_A", "seed": 1729,      "seed_label": "A-002", "notes": "Independent seed"},
    {"run": "E03-A-003", "condition": "CONTROL_A", "seed": 20240903,   "seed_label": "A-003", "notes": "Independent seed"},
    {"run": "E03-B-001", "condition": "CONTROL_B", "seed": 42,        "seed_label": "B-001", "notes": "Matched seed to A-001 for direct comparison"},
    {"run": "E03-B-002", "condition": "CONTROL_B", "seed": 1729,      "seed_label": "B-002", "notes": "Matched seed to A-002"},
    {"run": "E03-B-003", "condition": "CONTROL_B", "seed": 20240903,   "seed_label": "B-003", "notes": "Matched seed to A-003"},
    {"run": "E03-C-001", "condition": "CONTROL_C", "seed": 42,        "seed_label": "C-001", "notes": "Matched seed to A/B-001"},
    {"run": "E03-C-002", "condition": "CONTROL_C", "seed": 1729,      "seed_label": "C-002", "notes": "Matched seed to A/B-002"},
    {"run": "E03-C-003", "condition": "CONTROL_C", "seed": 20240903,   "seed_label": "C-003", "notes": "Matched seed to A/B-003"}
  ],

  "run_duration": {
    "baseline_runs_ticks": 10000,
    "perturbation_run_baseline_ticks": 10000,
    "perturbation_at_tick": 5000,
    "counterfactual_same_initial_state": true,
    "counterfactual_only_change": "stabilizer_regime",
    "termination_rules": [
      "Pre-registered tick count reached",
      "Pre-registered hard-stop condition (collapse invariant) reached",
      "STOP condition from master prompt §22 reached"
    ],
    "never_terminate_because": "An intermediate metric looks favorable (master prompt §16)"
  },

  "measurement_schedule": {
    "checkpoints": [0, 100, 500, 1000, 2500, 5000, 7500, 10000],
    "checkpoints_count": 8,
    "record_at_each_checkpoint": [
      "diversity_metrics",
      "emergence_metrics_with_provenance",
      "adaptation_metrics",
      "stabilizer_pressure_metrics",
      "ecological_health_metrics"
    ]
  },

  "metrics": {
    "diversity": [
      "shannon_entropy_of_lineage_distribution",
      "lineage_distribution_counts",
      "dominance_max_lineage_share",
      "niche_occupancy_count",
      "lineage_diversity_count"
    ],
    "emergence_with_provenance": [
      "novel_structures_count",
      "novel_strategies_count",
      "new_niches_count",
      "new_behavioral_patterns_count",
      "unexpected_adaptations_count",
