  "per_intervention_record_schema": [
    "intervention_id",
    "timestamp",
    "trigger",
    "detected_state",
    "metric_values",
    "decision",
    "action",
    "magnitude",
    "affected_population",
    "expected_effect",
    "actual_effect",
    "recovery_time",
    "downstream_effects"
  ],

  "perturbation_protocol": {
    "perturbation_at_tick": 5000,
    "perturbation_types": [
      {"name": "lineage_dominance_shock",   "description": "Boost max-share lineage by +20%"},
      {"name": "entropy_reduction",         "description": "Collapse two niche axes"},
      {"name": "niche_removal",             "description": "Delete the largest niche"},
      {"name": "resource_redistribution",   "description": "Shift 50% of resources from largest niche to smallest"},
      {"name": "mutation_perturbation",     "description": "2x mutation rate for 500 ticks"},
      {"name": "population_imbalance",      "description": "Redistribute lineages toward uniform counts"}
    ],
    "measured_at_each_perturbation": [
      "time_to_recovery",
      "recovery_completeness_fraction",
      "diversity_preservation",
      "novelty_preservation",
      "stabilizer_effort",
      "post_recovery_trajectory"
    ]
  },

  "counterfactual_protocol": {
    "same_initial_state_as_observed": true,
    "only_change": "stabilizer_regime",
    "matrix": [
      {"observed": "CONTROL_A (OFF)", "counterfactual": "stabilizer ON at matched pressure"},
      {"observed": "CONTROL_B (ON)",  "counterfactual": "stabilizer OFF"},
      {"observed": "CONTROL_C (0.5)", "counterfactual": "stabilizer OFF"},
      {"observed": "CONTROL_C (0.5)", "counterfactual": "stabilizer full pressure (1.0)"}
    ]
  },

  "overreach_sweep_protocol": {
    "pressures_swept": [0.0, 0.25, 0.5, 0.75, 1.0],
    "seeds_per_pressure": 3,
    "total_sweep_runs": 15,
    "objective": "Find minimum effective stabilization, not maximum"
  },

  "monoculture_test_metrics": [
    "lineage_dominance",
    "entropy",
    "strategy_similarity",
    "ontology_similarity",
    "niche_convergence",
    "behavioral_convergence"
  ],

  "oscillation_test_metrics": [
