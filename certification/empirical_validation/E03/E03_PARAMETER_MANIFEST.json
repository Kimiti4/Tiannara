      "fitness_delta_mean",
      "environmental_response_correlation",
      "strategy_turnover_fraction",
      "lineage_persistence_fraction",
      "recovery_after_perturbation"
    ],
    "stabilizer_pressure": [
      "intervention_frequency_per_tick",
