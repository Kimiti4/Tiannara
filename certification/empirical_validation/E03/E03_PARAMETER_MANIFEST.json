    "delayed_collapse",
    "stabilizer_accumulation",
    "memory_effects",
    "feedback_oscillation",
    "hidden_monoculture",
    "novelty_decay"
  ],

  "primary_success_criteria": [
    {"id": "S1_stability",                "criterion": "Catastrophic collapse bounded", "operationalization": "No run reaches collapse_probability > 0.8 for >= 500 consecutive ticks"},
    {"id": "S2_diversity",                "criterion": "Diversity persists", "operationalization": "Median Shannon entropy across checkpoints >= 0.5 * baseline (CONTROL A) entropy at the same checkpoint"},
    {"id": "S3_exploration",              "criterion": "Exploration active", "operationalization": ">= 10% of t=0 lineages still present at tick 10000 AND new lineage appearances > 0"},
    {"id": "S4_novelty",                  "criterion": "Novelty appears", "operationalization": ">= 1 new strategy cluster emerges in >= 1 condition, classified ENDOGENOUS or STABILIZER_ASSISTED (not STABILIZER_INDUCED)"},
    {"id": "S5_adaptation",               "criterion": "Adaptation persists", "operationalization": "Mean lineage fitness Delta > 0 across the run"},
    {"id": "S6_recoverability",           "criterion": "Recoverability", "operationalization": ">= 80% of pre-perturbation diversity restored within 2000 ticks of perturbation"},
    {"id": "S7_non_overreach",            "criterion": "Non-overreach", "operationalization": "In the pressure sweep, ecological outcome remains non-degenerate at pressures <= 0.5"},
    {"id": "S8_reproducibility",          "criterion": "Reproducibility", "operationalization": "Coefficient of variation of Shannon entropy at tick 10000 <= 0.3 across 3 seeds of each condition"},
    {"id": "S9_measurement_integrity",    "criterion": "Measurement integrity", "operationalization": "Every claimed novel phenomenon is tagged with provenance classification; no result requires STABILIZER_INDUCED -> ENDOGENOUS reclassification to support H1"},
    {"id": "S10_falsifiability",          "criterion": "Falsifiability", "operationalization": "At least one of H0-A / H0-B / H0-C was actively tested and either rejected or partially supported by the data"}
  ],

  "primary_failure_conditions": [
    "persistent_monoculture: dominance > 0.8 sustained for >= 2000 ticks",
    "collapse_despite_stabilization",
    "stabilizer_induced_ecological_stagnation",
    "persistent_oscillatory_control",
    "novelty_collapse",
    "intervention_dominance: >= 50% of classified novel phenomena are STABILIZER_INDUCED in CONTROL B",
    "results_cannot_be_independently_reproduced",
    "measurement_boundary_ambiguous",
    "evidence_cannot_distinguish_endogenous_from_stabilizer_induced"
  ],

  "stop_conditions_master_prompt_section_22": [
    "Measurement integrity becomes uncertain",
    "A forbidden subsystem is modified (D1-D5, planner, AEO, GRCC, CIS redesign)",
    "Unregistered parameters are introduced",
    "Evidence artifacts become inconsistent",
    "The experiment produces an unbounded failure mode",
    "A safety or recovery invariant is violated",
    "Results can no longer be independently reconstructed",
    "Stabilizer behavior exceeds the authorized intervention boundary",
    "The campaign begins modifying D1-D5",
    "Any result requires retroactive alteration of the experimental record"
  ],

  "evidence_model": {
    "distinguish": ["fact", "evidence", "observation", "inference", "hypothesis", "unknown", "confidence"],
    "never_collapse_into_single_result": true
  },

  "provenance_schema": [
